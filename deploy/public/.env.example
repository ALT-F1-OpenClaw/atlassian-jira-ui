# Taskara — Public Deployment Configuration
# Copy to .env and fill in values

# ── Domain ──
DOMAIN=taskara.alt-f1.be
ACME_EMAIL=abdelkrim@alt-f1.be

# ── App Version ──
# Pin to a specific version tag, or use 'latest'
APP_VERSION=latest

# ── Jira OAuth 2.0 (required for production) ──
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ── Jira API Token (disabled in production, but required for config validation) ──
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=dummy-not-used-in-production

# ── Auth Settings ──
AUTH_API_TOKEN_ENABLED=false
AUTH_OAUTH_ENABLED=true
APP_ENV=production

# ── Security ──
# IMPORTANT: Change this! Used to derive encryption key for OAuth tokens.
# Changing it invalidates all existing sessions (users must re-login).
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# ── Redis ──
# Automatically set in docker-compose (redis://redis:6379/0)
# Only override if using an external Redis instance
# REDIS_URL=redis://redis:6379/0

# ── CORS ──
# Automatically set in docker-compose (https://${DOMAIN})
# CORS_ORIGINS=https://taskara.alt-f1.be
