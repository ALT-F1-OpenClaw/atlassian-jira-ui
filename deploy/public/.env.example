# Taskara — Production Configuration
# Copy to .env and fill in values
#
# In production, only OAuth 2.0 is used. Users log in with their own
# Atlassian account — no shared API token needed.

# ── Domain ──
DOMAIN=taskara.alt-f1.be
ACME_EMAIL=abdelkrim@alt-f1.be

# ── App Version ──
APP_VERSION=latest

# ── OAuth 2.0 (required) ──
# Register at https://developer.atlassian.com/console/myapps/
# Callback URL: https://taskara.alt-f1.be/auth/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ── Environment ──
APP_ENV=production
AUTH_API_TOKEN_ENABLED=false
AUTH_OAUTH_ENABLED=true

# ── Security ──
# IMPORTANT: Generate a random key. Changing it invalidates all sessions.
# Run: openssl rand -base64 48
APP_SECRET_KEY=change-me-to-a-random-string

# ── Redis ──
# Automatically set in docker-compose. Override only for external Redis.
# REDIS_URL=redis://redis:6379/0

# ── CORS ──
# Automatically set in docker-compose.
# CORS_ORIGINS=https://taskara.alt-f1.be
