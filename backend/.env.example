# ============================================================
# Jira UI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Jira Cloud credentials ---
# JIRA_HOST & JIRA_EMAIL: https://admin.atlassian.com/
# JIRA_API_TOKEN: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# --- OAuth 2.0 (3LO) ---
# Register an app at: https://developer.atlassian.com/console/myapps/
# Required products: "Jira API" + "Jira Software" (add both in Permissions)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# --- App Environment ---
# Values: development | staging | production
#
#   development  — Both API Token + OAuth available (default)
#                  Full Settings page with all options visible
#                  For local development and self-hosted single-user setups
#
#   staging      — Both API Token + OAuth available
#                  Same as development, for pre-production testing
#
#   production   — OAuth ONLY — API Token completely disabled
#                  API Token section hidden in Settings
#                  No fallback — users MUST log in with Atlassian
#                  For customer-facing deployments
#
APP_ENV=development

# --- Auth toggles ---
# Toggle individual auth methods (ignored in production for API Token)
AUTH_API_TOKEN_ENABLED=true
AUTH_OAUTH_ENABLED=true

# --- App settings ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-to-a-random-string
CORS_ORIGINS=http://localhost:5173
DEBUG=false
