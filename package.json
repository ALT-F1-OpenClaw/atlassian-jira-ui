{
  "name": "atlassian-jira-ui",
  "private": true,
  "version": "1.59.9",
  "description": "Modern alternative UI for Atlassian Jira Cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALT-F1-OpenClaw/atlassian-jira-ui.git"
  },
  "homepage": "https://github.com/ALT-F1-OpenClaw/atlassian-jira-ui#readme",
  "bugs": {
    "url": "https://github.com/ALT-F1-OpenClaw/atlassian-jira-ui/issues"
  },
  "scripts": {
    "patch": "node scripts/bump-version.mjs patch",
    "minor": "node scripts/bump-version.mjs minor",
    "major": "node scripts/bump-version.mjs major",
    "push": "git push && git push --tags",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "changelog:init": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "playwright": "^1.58.2"
  }
}
